# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/urban_heatwave
MONGO_DB_NAME=urban_heatwave

# Google Earth Engine
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# Open-Meteo (no key needed, but base URL is configurable)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Scheduler (UTC hour for daily recompute)
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# HVI Model Weights (optional — defaults in config.py)
# HVI_WEIGHT_LST=0.35
# HVI_WEIGHT_ELDERLY=0.25
# HVI_WEIGHT_OUTDOOR=0.25
# HVI_WEIGHT_GREEN=0.15
