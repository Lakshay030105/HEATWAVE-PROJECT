# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/urban_heatwave

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Comma-free single recipient used by the risk watcher demo dispatch
MY_PHONE_NUMBER=+919999999999
# Trial accounts can only send approved templates; set to true to send the custom body
TWILIO_USE_CUSTOM_SMS=false
TWILIO_SMS_TEMPLATE=sms_internal_alerts

# Firebase
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/firebase-adminsdk.json

# Server
PORT=5000
NODE_ENV=development

# AI Service URL (for internal calls)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=120000
